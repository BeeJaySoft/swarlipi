{
  "name": "swarlipi",
  "version": "0.0.1",
  "private": true,
  "description": "Fontless Bhatkhande notation renderer — real Unicode letters plus CSS/SVG marks, in four scripts.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/index.css",
    "./bridge": "./src/bridge.ts",
    "./samples": "./src/samples.ts",
    "./reference": "./src/reference.ts"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "bhatkhande",
    "notation",
    "indian-classical-music",
    "sargam",
    "gurmukhi",
    "devanagari"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs --port 5178",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --port 5178",
    "build:fonts": "python3 scripts/build-fonts.py"
  },
  "devDependencies": {
    "vitepress": "2.0.0-alpha.17",
    "vitest": "^4.0.18"
  }
}
